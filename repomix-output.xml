body {
  background: var(--color-bg);
  margin: 0;
  font-family: var(--font-body);
  color: var(--color-text);
  -webkit-font-smoothing: antialiased;
}

.container {
  max-width: 960px;
  margin: 48px auto;
  padding: 32px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}

h1 {
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 24px;
  color: var(--color-text);
}

h2 {
  font-size: 19px;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 6px;
  color: var(--color-text);
}

h3 {
  font-size: 15px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  margin: 32px 0 14px;
}

h3:first-of-type {
  margin-top: 0;
}

p {
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--color-border);
}

.top-bar h1 {
  margin-bottom: 0;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 13px;
  color: var(--color-text-secondary);
}

.error-text {
  color: var(--color-danger);
  font-size: 13px;
  margin-top: 10px;
}

.home-links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 24px;
}

.home-link-btn {
  display: block;
  text-align: center;
  padding: 13px 16px;
  background: var(--color-text);
  color: var(--color-surface);
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: opacity 0.15s ease;
}

.home-link-btn:hover {
  opacity: 0.85;
}

.home-link-btn.secondary {
  background: transparent;
  color: var(--color-text);
  border: 1px solid var(--color-border);
}

.home-link-btn.secondary:hover {
  background: var(--color-surface-alt);
  opacity: 1;
}

.reference-code {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0.02em;
  background: var(--color-surface-alt);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 14px;
  text-align: center;
  margin: 16px 0;
  color: var(--color-text);
}

.employee-form,
.upload-form {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--color-border);
}

.employee-form input,
.employee-form select,
.upload-form input,
.upload-form select {
  padding: 9px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  flex: 1 1 150px;
  background: var(--color-surface);
  color: var(--color-text);
  font-family: var(--font-body);
}

.employee-form input:focus,
.employee-form select:focus,
.upload-form input:focus,
.upload-form select:focus {
  outline: none;
  border-color: var(--color-accent);
}

.employee-form button,
.upload-form button {
  padding: 9px 18px;
  background: var(--color-text);
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  transition: opacity 0.15s ease;
}

.employee-form button:hover,
.upload-form button:hover {
  opacity: 0.85;
}

.search-bar {
  margin-bottom: 16px;
}

.search-bar input {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  background: var(--color-surface);
  color: var(--color-text);
  font-family: var(--font-body);
}

.search-bar input:focus {
  outline: none;
  border-color: var(--color-accent);
}

.scroll-panel {
  max-height: 480px;
  overflow-y: auto;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}

.scroll-status {
  text-align: center;
  padding: 14px;
  font-size: 12.5px;
  color: var(--color-text-muted);
}

.table-scroll {
  width: 100%;
  overflow-x: auto;
  overflow-y: auto;
  max-height: 560px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
}

.employee-table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
}

.employee-table th,
.employee-table td {
  text-align: left;
  padding: 16px 14px;
  border-bottom: 1px solid var(--color-border);
  font-size: 13.5px;
}

.employee-table th {
  color: var(--color-text-secondary);
  font-weight: 500;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.delete-btn {
  padding: 6px 12px;
  background: transparent;
  color: var(--color-danger);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 500;
  transition: background 0.15s ease;
}

.delete-btn:hover {
  background: var(--color-surface-alt);
  border-color: var(--color-danger);
}

.link-btn {
  padding: 6px 12px;
  background: transparent;
  color: var(--color-accent);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 500;
  transition: background 0.15s ease;
}

.link-btn:hover {
  background: var(--color-surface-alt);
  border-color: var(--color-accent);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 13, 11, 0.5);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  z-index: 100;
}

.modal {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 16px;
  padding: 24px;
  width: 100%;
  max-width: 520px;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: var(--shadow-card);
  animation: modal-pop 0.16s ease-out;
}

@keyframes modal-pop {
  from {
    opacity: 0;
    transform: scale(0.97) translateY(4px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.modal-header h2 {
  margin: 0;
}

.modal-employee-identity {
  display: flex;
  align-items: center;
  gap: 12px;
}

.modal-employee-identity h2 {
  margin: 0 0 4px;
}

.close-btn {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  color: var(--color-text-secondary);
  line-height: 1;
}

.close-btn:hover {
  background: var(--color-surface-alt);
  color: var(--color-text);
}

.document-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.document-list li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border);
  font-size: 13.5px;
  color: var(--color-text);
}

.document-list li a {
  color: var(--color-accent);
  text-decoration: none;
  word-break: break-word;
}

.document-list li a:hover {
  text-decoration: underline;
}

.document-list .empty {
  color: var(--color-text-muted);
  font-style: italic;
}

.tab-nav {
  display: flex;
  gap: 4px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--color-border);
  overflow-x: auto;
}

.tab-nav button {
  padding: 10px 16px;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  font-size: 14px;
  font-weight: 500;
  color: var(--color-text-secondary);
  cursor: pointer;
  white-space: nowrap;
}

.tab-nav button:hover {
  color: var(--color-text);
}

.tab-nav button.active {
  color: var(--color-text);
  border-bottom-color: var(--color-text);
}

.message-center-layout {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.conversation-list-panel {
  width: 260px;
  flex-shrink: 0;
}

.thread-panel {
  flex: 1;
  min-width: 0;
}

.hide-on-desktop {
  display: none;
}

.chat-thread {
  max-height: 420px;
  overflow-y: auto;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--color-surface-alt);
}

.chat-bubble {
  align-self: flex-start;
  max-width: 75%;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 8px 12px;
  font-size: 13.5px;
  color: var(--color-text);
}

.chat-bubble.mine {
  align-self: flex-end;
  background: var(--color-accent);
  color: #fff;
  border-color: var(--color-accent);
}

.chat-bubble-tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--color-warning);
  margin-bottom: 4px;
}

.chat-bubble.mine .chat-bubble-tag {
  color: #ffe6b3;
}

.chat-bubble-time {
  display: block;
  font-size: 11px;
  margin-top: 4px;
  color: var(--color-text-muted);
}

.chat-bubble.mine .chat-bubble-time {
  color: rgba(255, 255, 255, 0.75);
}

@media (max-width: 600px) {
  .container {
    margin: 0;
    padding: 20px;
    border-radius: 0;
    border-left: none;
    border-right: none;
  }

  .employee-form,
  .upload-form {
    flex-direction: column;
  }

  .employee-form input,
  .employee-form select,
  .employee-form button,
  .upload-form input,
  .upload-form select,
  .upload-form button {
    width: 100%;
  }

  .top-bar {
    flex-direction: column;
    align-items: flex-start;
  }

  .tab-nav {
    gap: 0;
  }

  .message-center-layout {
    flex-direction: column;
  }

  .conversation-list-panel.hide-on-mobile {
    display: none;
  }

  .hide-on-desktop {
    display: inline-block;
  }
}

/* ============================================================
   Public Home Page
   ============================================================ */

.home-page {
  max-width: 100%;
  overflow-x: hidden;
}

.site-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-surface);
  background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  backdrop-filter: saturate(180%) blur(14px);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  border-bottom: 1px solid var(--color-border);
}

.site-nav-inner {
  max-width: 1120px;
  margin: 0 auto;
  padding: 14px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.brand {
  display: flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  color: var(--color-text);
}

.brand-mark {
  display: inline-flex;
  color: var(--color-accent);
}

.brand-wordmark {
  font-family: Arial, Helvetica, sans-serif;
  font-weight: 900;
  font-size: 20px;
  letter-spacing: -0.03em;
  text-transform: lowercase;
  color: var(--color-text);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 14px;
}

.nav-links a {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-weight: 500;
  transition: color 0.15s ease;
}

.nav-links a:hover {
  color: var(--color-text);
}

.theme-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  cursor: pointer;
  flex-shrink: 0;
  transition: background 0.15s ease, transform 0.1s ease;
}

.theme-toggle-btn:hover {
  background: var(--color-surface-alt);
}

.theme-toggle-btn:active {
  transform: scale(0.92);
}

.hero {
  position: relative;
  max-width: 1120px;
  margin: 0 auto;
  padding: 88px 32px 64px;
  text-align: center;
  overflow: hidden;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-kicker {
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-accent);
  margin: 0 0 14px;
}

.hero-title {
  font-size: 46px;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: -0.02em;
  max-width: 720px;
  margin: 0 0 18px;
  color: var(--color-text);
}

.hero-subtitle {
  font-size: 17px;
  line-height: 1.6;
  max-width: 560px;
  color: var(--color-text-secondary);
  margin: 0 0 32px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 56px;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.hero-illustration {
  width: 220px;
  height: auto;
}

.hero-wall-art {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 260px;
  height: 420px;
  z-index: 1;
  pointer-events: none;
  opacity: 0.5;
}

.hero-wall-art-left {
  left: -110px;
}

.hero-wall-art-right {
  right: -110px;
}

.wall-shape {
  fill: var(--color-surface-alt);
  stroke: var(--color-border);
  stroke-width: 1.5;
}

.wall-shape-alt {
  fill: none;
  stroke: var(--color-border);
  stroke-width: 1.5;
}

.wall-line {
  stroke: var(--color-text-muted);
  stroke-width: 2;
  stroke-linecap: round;
  opacity: 0.55;
}

.wall-line-thin {
  stroke: var(--color-border);
  stroke-width: 1.5;
  stroke-linecap: round;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 26px;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  border: 1px solid transparent;
  transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  -webkit-tap-highlight-color: transparent;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: var(--color-accent);
  color: #fff;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 6px 16px -6px var(--color-accent);
}

.btn-primary:hover {
  background: var(--color-accent-hover);
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border-color: var(--color-border);
}

.btn-secondary:hover {
  background: var(--color-surface-alt);
  border-color: var(--color-text-muted);
}

.photo-strip {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 32px 8px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.photo-strip-item {
  aspect-ratio: 4 / 3;
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--color-border);
}

.photo-strip-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: grayscale(15%);
}

.feature-row {
  max-width: 1000px;
  margin: 0 auto;
  padding: 56px 32px;
  display: flex;
  align-items: center;
  gap: 56px;
}

.feature-row.reverse {
  flex-direction: row-reverse;
}

.feature-visual {
  flex: 0 0 auto;
  width: 160px;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  background: var(--color-surface-alt);
  color: var(--color-accent);
  transition: transform 0.2s ease;
}

.feature-row:hover .feature-visual {
  transform: translateY(-4px);
}

.feature-visual svg {
  width: 74px;
  height: 74px;
}

.feature-copy {
  flex: 1 1 auto;
}

.feature-copy h2 {
  margin-bottom: 10px;
}

.feature-copy p {
  max-width: 460px;
  margin-bottom: 14px;
}

.feature-link {
  color: var(--color-accent);
  font-weight: 600;
  font-size: 14.5px;
  text-decoration: none;
}

.feature-link:hover {
  text-decoration: underline;
}

.site-footer {
  border-top: 1px solid var(--color-border);
  margin-top: 40px;
  padding: 40px 32px 28px;
  background: var(--color-surface-alt);
}

.site-footer-inner {
  max-width: 1120px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--color-border);
}

.footer-brand p {
  margin: 4px 0 0;
  font-size: 13px;
}

.footer-links {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
}

.footer-links a {
  color: var(--color-text-secondary);
  text-decoration: none;
  font-size: 13.5px;
}

.footer-links a:hover {
  color: var(--color-text);
}

.footer-copyright {
  max-width: 1120px;
  margin: 20px auto 0;
  font-size: 12.5px;
  color: var(--color-text-muted);
}

.doc-outline {
  stroke: var(--color-border);
  stroke-width: 2;
  fill: var(--color-surface);
}

.doc-line {
  stroke: var(--color-text-muted);
  stroke-width: 3;
  stroke-linecap: round;
}

.badge-circle {
  fill: var(--color-accent);
}

.badge-pulse {
  fill: none;
  stroke: var(--color-accent);
  stroke-width: 2;
  transform-box: fill-box;
  transform-origin: center;
  animation: pulse-ring 2.6s ease-out infinite;
}

.badge-check {
  fill: none;
  stroke: #fff;
  stroke-width: 5;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 40;
  stroke-dashoffset: 40;
  animation: draw-check 2.6s ease-in-out infinite;
}

@keyframes pulse-ring {
  0% {
    transform: scale(1);
    opacity: 0.55;
  }
  100% {
    transform: scale(1.7);
    opacity: 0;
  }
}

@keyframes draw-check {
  0%,
  15% {
    stroke-dashoffset: 40;
  }
  40%,
  100% {
    stroke-dashoffset: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .badge-pulse,
  .badge-check {
    animation: none;
  }
}

@media (max-width: 900px) {
  .hero-wall-art {
    opacity: 0.3;
    width: 200px;
  }

  .hero-wall-art-left {
    left: -140px;
  }

  .hero-wall-art-right {
    right: -140px;
  }
}

@media (max-width: 700px) {
  .photo-strip {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .site-nav-inner {
    padding: 12px 20px;
  }

  .nav-links {
    order: 3;
    width: 100%;
    justify-content: center;
    gap: 18px;
    font-size: 13px;
    padding-top: 8px;
  }

  .hero {
    padding: 56px 20px 44px;
  }

  .hero-wall-art {
    display: none;
  }

  .hero-title {
    font-size: 32px;
  }

  .hero-subtitle {
    font-size: 15.5px;
  }

  .feature-row,
  .feature-row.reverse {
    flex-direction: column;
    text-align: center;
    padding: 40px 20px;
    gap: 24px;
  }

  .feature-copy p {
    margin-left: auto;
    margin-right: auto;
  }

  .site-footer-inner {
    flex-direction: column;
    gap: 18px;
  }

  .footer-links {
    gap: 16px;
  }
}
/* ============================================================
   Legal & Static Pages (Terms, Privacy, Contact HR)
   ============================================================ */

.legal-container {
  max-width: 760px;
}

.legal-updated {
  font-size: 12.5px;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: -8px 0 4px;
}

.legal-content h2 {
  font-size: 16px;
  margin: 32px 0 10px;
}

.legal-content h2:first-child {
  margin-top: 0;
}

.legal-content p,
.legal-content li {
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.legal-content ul {
  margin: 0 0 16px;
  padding-left: 20px;
}

.legal-content ul li {
  margin-bottom: 6px;
}

.legal-back-row {
  margin-top: 32px;
  padding-top: 20px;
  border-top: 1px solid var(--color-border);
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin: 24px 0 8px;
}

.contact-card {
  padding: 18px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface-alt);
}

.contact-card-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
  margin: 0 0 6px;
}

.contact-card-value {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text);
  margin: 0;
}

.contact-card-value a {
  color: var(--color-accent);
  text-decoration: none;
}

.contact-card-value a:hover {
  text-decoration: underline;
}

@media (max-width: 600px) {
  .contact-grid {
    grid-template-columns: 1fr;
  }
}
/* ============================================================
   Auth & Public Forms (Login, Apply, Status, Self-Register)
   ============================================================ */

.btn-block {
  width: 100%;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.auth-card {
  max-width: 420px;
  margin: 64px auto 96px;
  padding: 40px 36px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}

.auth-card h1 {
  font-size: 22px;
  margin-bottom: 6px;
  text-align: center;
}

.auth-subtitle {
  margin: 0 0 28px;
  font-size: 14px;
  text-align: center;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.field-label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.field-group input,
.field-group select {
  padding: 12px 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 15px;
  background: var(--color-surface);
  color: var(--color-text);
  font-family: var(--font-body);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.field-group input:focus,
.field-group select:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
}

.auth-footer-note {
  margin: 20px 0 0;
  text-align: center;
  font-size: 13px;
  color: var(--color-text-muted);
}

.auth-footer-note a {
  color: var(--color-accent);
  text-decoration: none;
  font-weight: 600;
}

.auth-footer-note a:hover {
  text-decoration: underline;
}

.file-field {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.file-field-btn {
  padding: 10px 18px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface-alt);
  color: var(--color-text);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.file-field-btn:hover {
  background: var(--color-surface);
  border-color: var(--color-accent);
}

.file-field-name {
  font-size: 13px;
  color: var(--color-text-muted);
}

.vacancy-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
  margin: 8px 0 24px;
}

.vacancy-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: var(--color-surface);
  transition: border-color 0.15s ease, transform 0.15s ease;
}

.vacancy-card:hover {
  border-color: var(--color-accent);
  transform: translateY(-2px);
}

.vacancy-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.vacancy-card-title {
  font-size: 16px;
  margin: 0;
  color: var(--color-text);
}

.vacancy-deadline-pill {
  align-self: flex-start;
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 600;
  padding: 4px 9px;
  border-radius: 999px;
  background: var(--color-surface-alt);
  color: var(--color-text-muted);
  white-space: nowrap;
}

.vacancy-card-dept {
  margin: 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-accent);
}

.vacancy-card-desc {
  margin: 0;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--color-text-secondary);
  flex: 1;
}

.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 40px 20px;
  color: var(--color-text-muted);
  font-size: 14px;
}

.status-result {
  margin-top: 28px;
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-surface-alt);
}

.status-result-label {
  margin: 0 0 4px;
  font-size: 11.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
}

.status-result-value {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-text);
}

.status-pill {
  display: inline-block;
  margin-top: 2px;
  padding: 5px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-text);
}

.status-applicant { color: var(--color-text-secondary); }
.status-under-review { color: var(--color-warning); border-color: var(--color-warning); }
.status-interview { color: var(--color-accent); border-color: var(--color-accent); }
.status-hired { color: var(--color-success); border-color: var(--color-success); }
.status-rejected { color: var(--color-danger); border-color: var(--color-danger); }

@media (max-width: 600px) {
  .auth-card {
    margin: 32px 16px 64px;
    padding: 28px 22px;
  }

  .vacancy-grid {
    grid-template-columns: 1fr;
  }
}

/* ============================================================
   Theme: Secondary Blue Accent (info / secondary badges)
   ============================================================ */

:root {
  --color-info: #2563eb;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --color-info: #5b8def;
  }
}

:root[data-theme="dark"] {
  --color-info: #5b8def;
}

/* Reserve orange for primary CTAs only — secondary in-context actions
   (Manage, Grant Access, Cancel, etc.) now read as blue everywhere. */
.link-btn {
  color: var(--color-info);
}

.link-btn:hover {
  border-color: var(--color-info);
}

/* ============================================================
   Internal Dashboard Shell
   ============================================================ */

.dash-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-surface);
  background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  backdrop-filter: saturate(180%) blur(14px);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  border-bottom: 1px solid var(--color-border);
}

.dash-header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.dash-brand {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--color-text);
}

.dash-user-cluster {
  display: flex;
  align-items: center;
  gap: 14px;
}

.dash-user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
}

.dash-user-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--color-accent) 16%, transparent);
  color: var(--color-accent);
  font-size: 12.5px;
  font-weight: 700;
  flex-shrink: 0;
}

.dash-user-info {
  display: flex;
  flex-direction: column;
  line-height: 1.25;
}

.dash-user-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--color-text);
}

.dash-user-role {
  font-size: 11.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--color-info);
}

.btn-outline-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9px 18px;
  border-radius: 999px;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  background: transparent;
  color: var(--color-danger);
  border: 1px solid var(--color-border);
  transition: background 0.15s ease, border-color 0.15s ease;
}

.btn-outline-danger:hover {
  background: var(--color-surface-alt);
  border-color: var(--color-danger);
}

/* Wide, unboxed shell for internal pages — replaces the narrow public
   `.container` so the dashboard actually uses the viewport instead of
   sitting in a small centered card with dead space on either side.
   Individual sections get their own `.dash-panel` cards instead. */
.dash-content {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px 40px 72px;
}

.dash-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: 28px;
  margin-bottom: 24px;
}

.dash-page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin: 4px 0 28px;
  flex-wrap: wrap;
}

.dash-page-heading {
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.015em;
  margin: 0 0 6px;
  color: var(--color-text);
}

.dash-page-subtitle {
  margin: 0;
  font-size: 14px;
  color: var(--color-text-secondary);
}

.dash-header-art {
  color: var(--color-border);
  flex-shrink: 0;
  display: none;
}

@media (min-width: 900px) {
  .dash-header-art {
    display: block;
  }
}

.dash-tabs {
  display: inline-flex;
  gap: 4px;
  padding: 4px;
  margin-bottom: 24px;
  background: var(--color-surface-alt);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  max-width: 100%;
  overflow-x: auto;
}

.dash-tab {
  padding: 8px 16px;
  border: none;
  border-radius: 999px;
  background: transparent;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--color-text-secondary);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease;
}

.dash-tab:hover {
  color: var(--color-text);
}

.dash-tab.active {
  background: var(--color-accent);
  color: #fff;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11.5px;
  font-weight: 600;
}

.chip-info {
  background: color-mix(in srgb, var(--color-info) 14%, transparent);
  color: var(--color-info);
}

.chip-you {
  background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  color: var(--color-accent);
  margin-left: 6px;
}

.employee-name-cell {
  display: flex;
  align-items: center;
  gap: 10px;
}

.employee-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 999px;
  background: var(--color-surface-alt);
  color: var(--color-text-secondary);
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
}

.employee-table tbody tr:hover {
  background: var(--color-surface-alt);
}

/* Stat strip — real, already-fetched numbers (total / departments /
   positions), giving the page a sense of scale before the table. */
.dash-stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.dash-stat-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
}

.dash-stat-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  color: var(--color-accent);
  flex-shrink: 0;
}

.dash-stat-icon.info {
  background: color-mix(in srgb, var(--color-info) 12%, transparent);
  color: var(--color-info);
}

.dash-stat-icon.slate {
  background: color-mix(in srgb, var(--color-text-secondary) 14%, transparent);
  color: var(--color-text-secondary);
}

.dash-stat-value {
  font-size: 22px;
  font-weight: 700;
  margin: 0;
  color: var(--color-text);
  line-height: 1.2;
}

.dash-stat-label {
  margin: 2px 0 0;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
}

.dash-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.dash-section-title {
  font-size: 18px;
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--color-text);
}

.dash-section-subtitle {
  margin: 0;
  font-size: 13px;
  color: var(--color-text-muted);
}

.btn-add {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 999px;
  background: var(--color-accent);
  color: #fff;
  border: 1px solid transparent;
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 6px 16px -6px var(--color-accent);
  transition: background 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
}

.btn-add:hover {
  background: var(--color-accent-hover);
}

.btn-add:active {
  transform: scale(0.97);
}

.btn-add.is-open {
  background: var(--color-surface-alt);
  color: var(--color-text);
  box-shadow: none;
  border-color: var(--color-border);
}

.dash-form-card {
  padding: 20px;
  margin-bottom: 24px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: var(--color-surface);
  animation: form-panel-in 0.18s ease-out;
}

@keyframes form-panel-in {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dash-form-title {
  margin: 0 0 16px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
}

.dash-form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
}

.dash-form-grid .field-group input,
.dash-form-grid .field-group select {
  padding: 10px 12px;
  font-size: 14px;
}

.dash-form-actions {
  margin-top: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Table wrapped in its own card, separate from stat cards and the
   add-employee form, so the page reads as distinct, breathing panels
   rather than one dense box. */
.dash-table-panel {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: 20px;
}

.dash-table-panel .search-bar {
  margin-bottom: 14px;
}

.dash-profile-card {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.dash-profile-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--color-accent) 16%, transparent);
  color: var(--color-accent);
  font-size: 16px;
  font-weight: 700;
  flex-shrink: 0;
}

.dash-profile-info {
  flex: 1;
  min-width: 180px;
}

.dash-profile-info h2 {
  margin: 0 0 4px;
}

.dash-profile-info p {
  margin: 0;
  font-size: 13.5px;
}

.table-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 56px 20px;
  color: var(--color-text-muted);
}

.table-empty-art {
  opacity: 0.85;
}

.table-empty-title {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin: 4px 0 0;
}

.table-empty-sub {
  font-size: 13px;
  color: var(--color-text-muted);
  margin: 0;
}

/* Status pill colors not already covered by the auth-pages block */
.status-active { color: var(--color-success); border-color: var(--color-success); }
.status-exited { color: var(--color-text-muted); }

@media (max-width: 900px) {
  .dash-content {
    padding: 28px 24px 56px;
  }
}

@media (max-width: 700px) {
  .dash-header-inner {
    padding: 12px 20px;
  }

  .dash-user-name,
  .dash-user-role {
    display: none;
  }

  .dash-content {
    padding: 20px 16px 48px;
  }

  .dash-panel,
  .dash-table-panel {
    padding: 18px;
  }

  .dash-page-heading {
    font-size: 22px;
  }

  .dash-section-header {
    align-items: flex-start;
  }

  .btn-add {
    width: 100%;
    justify-content: center;
  }
}

@media (max-width: 600px) {
  .dash-form-grid {
    grid-template-columns: 1fr;
  }

  .dash-profile-card {
    flex-direction: column;
    align-items: flex-start;
  }
}
