          onRefresh={onRefreshDocuments}
          readOnly={isAdmin}
        />
        <LeaveSection
          token={token}
          employeeId={employee.id}
          leaveRequests={leaveRequests}
          isEmployeeRole={false}
          onRefresh={onRefreshLeave}
        />
        <ExitSection
